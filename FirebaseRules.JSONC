{
// Allow anyone to read data, but only authenticated content owners can
// make changes to their data

  "rules": {
    ".read": true,
    ".write": false,
    "users": {
      "$uid": {
        ".read": true,
        // or ".read": "auth.uid !== null" for only authenticated users
        ".write": "auth.uid === $uid"
      }
    }
  }
}